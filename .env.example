# ============================================================
# Match Point Lima Norte — variables de entorno
# Copia este archivo a `.env` y completa los valores.
# En Railway se cargan en la pestaña "Variables" del servicio.
# ============================================================

# --- Base de datos (PostgreSQL) -----------------------------
# Local (docker compose):
DATABASE_URL=postgresql://matchpoint:matchpoint@localhost:5432/matchpoint
# En Railway usa la referencia: ${{Postgres.DATABASE_URL}}

# --- Seguridad ----------------------------------------------
# Cadena larga y aleatoria. Generar con: openssl rand -hex 32
PAYLOAD_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- URL pública del sitio ----------------------------------
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En Railway, antes de tener dominio propio, usa la URL *.up.railway.app.
# Cuando conectes tu dominio, actualiza solo esta variable (ver README).

# --- Correo (recuperar contraseña y formulario de contacto) -
# Dirección que recibe los avisos del formulario de contacto.
CONTACT_EMAIL_TO=adriansalazar2497@gmail.com
# Remitente. Con Resend sin dominio verificado usa: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Match Point Lima Norte
# API key de Resend (https://resend.com). Si se deja vacía, los correos
# se imprimen en la consola del servidor (útil en local).
RESEND_API_KEY=

# --- Imágenes en Cloudflare R2 (S3 compatible) --------------
# Si se dejan vacías, las imágenes se guardan en disco local (solo para desarrollo).
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# URL pública del bucket (dominio r2.dev o dominio propio), sin "/" final.
S3_PUBLIC_URL=

# --- Analítica (opcional) -----------------------------------
# Google Analytics 4. También se puede poner desde el admin (Configuración > Integraciones).
NEXT_PUBLIC_GA_ID=

# --- Semilla (solo para `npm run seed`) ---------------------
# Usuario administrador inicial. Cámbiala después de entrar.
SEED_ADMIN_EMAIL=adriansalazar2497@gmail.com
SEED_ADMIN_PASSWORD=
